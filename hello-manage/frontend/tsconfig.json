{
  /* Vite transpiles with esbuild and never checks types, so without this the
     admin's .tsx was the only code in the repo nothing verified. Mirrors
     hello-web's config so both front ends are checked the same way. */
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",

    "jsx": "react-jsx",
    "isolatedModules": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "noEmit": true,

    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src", "vite.config.ts"]
}
