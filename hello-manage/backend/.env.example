# Hello Manage backend configuration.

# Port the admin/booking API listens on (Cloud Run sets PORT automatically).
PORT="4000"

# Admin dashboard credentials. CHANGE THESE in production.
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="1234"

# Secret used to sign admin session tokens. Use a long random string in production.
ADMIN_SECRET="dev-insecure-secret-change-me"

# Comma-separated origins allowed to call the public API. "*" allows any (dev only).
CORS_ORIGINS="*"

# Optional: override the SQLite database file location.
# DB_FILE="/data/hellorent.db"

MONGODB_URI="mongodb://127.0.0.1:27017/?replicaSet=rs0"
MONGODB_DB="hellorent"

# Email — optional. These only seed the settings on first run; after that the
# admin owns them, and anything saved in Settings wins.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
SMTP_FROM_NAME="Hello Rent"
